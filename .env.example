# Copy this file to .env and fill in whichever keys you have.
# The app uses the FIRST available provider, in this order, and falls back to the next one
# if a call fails (e.g. the free-tier rate limit is hit):
#   1. Gemini   2. Groq   3. Ollama (local)   4. Claude
# With none of them, the app still runs and quotes the best-matching policy passage.

# 1. Google Gemini - free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# 2. Groq - free key at https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# 3. Ollama - free, runs locally. Install from https://ollama.com, then: ollama pull llama3.2
# Used automatically when the Ollama app is running and the model is pulled.
# OLLAMA_MODEL=llama3.2
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_DISABLED=1

# 4. Anthropic Claude - paid, https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
